# Verus daemon JSON-RPC endpoint and basic-auth credentials.
# Copy to .env and fill in real values (.env is gitignored).
# These come from the daemon's config file (e.g. ~/.komodo/vrsctest/vrsctest.conf):
#   rpcuser / rpcpassword / rpcport
VERUS_RPC_URL=http://localhost:18843
VERUS_RPC_USER=your_rpcuser
VERUS_RPC_PASS=your_rpcpassword

# Web server bind address and port.
# HOST=0.0.0.0 exposes the UI to your LAN (anyone on the network can drive the daemon).
# HOST=127.0.0.1 restricts it to this machine.
HOST=0.0.0.0
PORT=8787
